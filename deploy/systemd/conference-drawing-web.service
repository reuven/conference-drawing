# Managed by conference-drawing (deploy/remote/install.sh).
[Unit]
Description=conference-drawing web app (gunicorn on a unix socket)
After=network.target postgresql.service conference-drawing-web.socket
Requires=postgresql.service
Requires=conference-drawing-web.socket

[Service]
Type=notify
NotifyAccess=main
User=conference-drawing
Group=conference-drawing
Environment=CD_ENV_FILE=/srv/conference-drawing/data/.env
Environment=CD_DATA_DIR=/srv/conference-drawing/data
Environment=CD_VERSION_FILE=/srv/conference-drawing/version.json
Environment=CD_DB_HOST=/var/run/postgresql
# The listening socket comes from conference-drawing-web.socket (LISTEN_FDS),
# which sets its permissions; so no --bind here.
# No gunicorn access log: request lines carry display tokens and query strings.
# No control socket: gunicorn 25+ writes it under the working directory, which
# is read-only here, and nothing uses gunicornc.
# gunicorn tells systemd when it is ready (Type=notify), so "start" waits.
ExecStart=/srv/conference-drawing/venv/bin/gunicorn --workers 2 --no-control-socket conference_drawing.wsgi:application
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
UMask=007

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/conference-drawing/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
# No capabilities, no setuid files, a system-call allowlist, other users'
# processes hidden. Reaches PostgreSQL by unix socket (CD_DB_HOST); no IP sockets.
ProtectProc=invisible
CapabilityBoundingSet=
SystemCallFilter=@system-service
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
