# Managed by conference-drawing (deploy/remote/install.sh). Do not edit by hand:
# the next install overwrites this file and uninstall removes it.
#
# No trusted_proxies here: Caddy then ignores any X-Forwarded-For a client
# sends and passes the connecting address alone, which is what the app's rate
# limit (raffle/views/public.py client_ip) relies on.
__DOMAIN__ {
	request_body {
		max_size 6MB
	}

	# Access log without secrets: display tokens become REDACTED (any case,
	# repeated slashes, %-escaped letters or slashes), and every query string
	# is dropped (entry pages under /c/, admin searches). No header is logged
	# at all: Referer, htmx's HX-Current-URL and a redirect's Location all
	# repeat a page URL, and a new header must not leak one unreviewed.
	#
	# Caddy's error log ignores these filters, so a failed upstream (the app
	# restarting during an upgrade) is answered by handle_errors below; Caddy
	# then logs the error at DEBUG only, and the raw URI never reaches a log.
	log conference-drawing {
		output file /var/log/caddy/conference-drawing.access.log {
			roll_keep 5
			roll_keep_for 336h
		}
		format filter {
			request>uri multi_regexp {
				regexp "(?i)((?:/|%2f)+(?:d|%64)(?:i|%69)(?:s|%73)(?:p|%70)(?:l|%6c)(?:a|%61)(?:y|%79)(?:/|%2f)+)[^/?#]+" "${1}REDACTED"
				regexp "\?.*" ""
			}
			request>headers delete
			resp_headers delete
		}
	}

	# HTTPS only, for this host alone: the host is shared, so sibling
	# subdomains are left out of HSTS. Deleting Server (deferred, as every delete is) also
	# drops the one gunicorn sends.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle_errors 5xx {
		respond "Temporarily unavailable" 503
	}

	handle /static/* {
		root * /srv/conference-drawing/data
		file_server
	}

	handle /media/* {
		root * /srv/conference-drawing/data
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'"
		file_server
	}

	handle {
		# Ride out a restart (a few seconds) instead of answering 502.
		reverse_proxy unix//run/conference-drawing/web.sock {
			lb_try_duration 15s
			lb_try_interval 500ms
			# Read up to 1MB of a body before a sync gunicorn worker sees it,
			# so a client trickling a slow body can't tie up a worker.
			request_buffers 1MB
		}
	}
}
